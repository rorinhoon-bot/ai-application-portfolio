# P3 local MCP service example configuration.
# Copy to .env only for local use. Do not commit .env or identity.json.

# Identity file must be deployed in a controlled directory and pre-exist.
# Its JSON schema is documented in docs/D-3-design.md.
MCP_NOTES_IDENTITY_FILE=./.mcp-notes/identity.json

# Optional equality assertion only. It never creates or falls back to a subject.
# MCP_NOTES_SUBJECT=local-demo

# State database parent directory may be created by server.main().
MCP_NOTES_DB_PATH=./.mcp-notes/control.db

# Task root and its ancestors must be pre-created by trusted deployment setup.
MCP_NOTES_TASK_ROOT=./.mcp-notes/tasks

# Use only original fictional notes for demos and tests.
MCP_NOTES_NOTES_ROOT=./evals/fixtures/notes-v1

# Default: stdio. Optional local-only HTTP mode is explicit and loopback-only.
MCP_NOTES_TRANSPORT=stdio
MCP_NOTES_HOST=127.0.0.1
MCP_NOTES_PORT=8000
