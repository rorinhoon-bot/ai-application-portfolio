# Restrict LangGraph checkpoint deserialization to known-safe modules.
LANGGRAPH_STRICT_MSGPACK=true

# Keep the optional LangSmith service disabled for this offline project.
LANGSMITH_TRACING=false

# V2 live mode only. Copy to P2/.env; run_research_v2.py loads only this P2 file.
# Leave empty for default offline CLI and tests. Never commit P2/.env.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
